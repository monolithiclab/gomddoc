<!DOCTYPE html>
<html lang="en">
    <head>
        <title>{{ if .Page.Meta.title }}{{ .Page.Meta.title }} | {{ end }}{{ .Site.Meta.Title }}</title>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="color-scheme" content="light dark">
        <meta name="description" content="{{ .Site.Meta.Description }}">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css" />
        <script type="module">
            import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
            mermaid.initialize({ startOnLoad: false });
            await mermaid.run({
                querySelector: '.language-mermaid',
            });
        </script>
        <style>
        :root {
            --pico-font-size: 90%;
        }
        /* GitHub-style admonitions */
        .admonition { padding: 1rem 1.5rem; margin: 1rem 0; border-left: 4px solid; border-radius: 4px; }
        .admonition-title { font-weight: bold; margin-bottom: 0.5rem; }
        .admonition-note { border-color: #448aff; background: rgba(68,138,255,0.1); }
        .admonition-tip { border-color: #00c853; background: rgba(0,200,83,0.1); }
        .admonition-important { border-color: #7c4dff; background: rgba(124,77,255,0.1); }
        .admonition-warning { border-color: #ff9100; background: rgba(255,145,0,0.1); }
        .admonition-caution { border-color: #ff5252; background: rgba(255,82,82,0.1); }
        /* Heading anchor links */
        .heading-anchor {
            text-decoration: none;
            color: var(--pico-muted-color);
            opacity: 0;
            margin-left: 0.5rem;
            transition: opacity 0.2s;
            font-weight: normal;
        }
        h1:hover .heading-anchor,
        h2:hover .heading-anchor,
        h3:hover .heading-anchor,
        h4:hover .heading-anchor,
        h5:hover .heading-anchor,
        h6:hover .heading-anchor {
            opacity: 1;
        }
        .heading-anchor:hover {
            color: var(--pico-primary);
        }
        .page-layout {
            display: flex;
            gap: 2rem;
            align-items: flex-start;
        }
        #toc-sidebar {
            width: 250px;
            flex-shrink: 0;
            position: sticky;
            top: 2rem;
            max-height: calc(100vh - 4rem);
            overflow-y: auto;
            font-size: 0.9em;
            padding-right: 1rem;
        }
        .page-content {
            flex-grow: 1;
            min-width: 0; /* Prevents overflow in flex items */
        }
        #toc-sidebar ul {
            list-style: none;
            padding-left: 1rem;
            margin: 0;
        }
        #toc-sidebar ul ul {
            padding-left: 1rem;
        }
        #toc-sidebar li {
            margin-bottom: 0.25rem;
        }
        #toc-sidebar a {
            color: var(--pico-muted-color);
            text-decoration: none;
            display: block;
            padding: 2px 0;
            transition: color 0.2s, padding-left 0.2s;
        }
        #toc-sidebar a:hover {
            color: var(--pico-color);
        }
        #toc-sidebar a.active {
            color: var(--pico-primary);
            font-weight: bold;
            border-left: 2px solid var(--pico-primary);
            padding-left: 0.5rem;
            margin-left: -0.6rem; /* visual compensation for border */
        }
        #theme-toggle {
            padding: 0.25rem 0.5rem;
            margin: 0;
            font-size: 1rem;
            line-height: 1;
            border: none;
            background: none;
            cursor: pointer;
        }
        #toc-toggle {
            display: none;
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            z-index: 100;
            padding: 0.5rem;
            border-radius: 50%;
            width: 3.5rem;
            height: 3.5rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        
        pre { position: relative; }
        .copy-btn {
            position: absolute;
            top: 0.5rem;
            right: 0.5rem;
            padding: 0.25rem 0.5rem;
            font-size: 0.75rem;
            cursor: pointer;
            opacity: 0;
            transition: opacity 0.2s;
            border: 1px solid var(--pico-muted-border-color);
            border-radius: 4px;
            background: var(--pico-background-color);
            color: var(--pico-muted-color);
        }
        pre:hover .copy-btn { opacity: 1; }
        .copy-btn:hover { color: var(--pico-color); }
        .copy-btn.copied { color: var(--pico-ins-color); }

        @media (max-width: 992px) {
            .page-layout {
                flex-direction: column;
            }
            #toc-sidebar {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                bottom: 0;
                width: 300px;
                max-width: 80vw;
                background: var(--pico-background-color);
                z-index: 101;
                padding: 2rem;
                box-shadow: 5px 0 15px rgba(0,0,0,0.1);
                border-right: 1px solid var(--pico-muted-border-color);
            }
            #toc-sidebar.show {
                display: block;
            }
            #toc-toggle {
                display: flex;
                align-items: center;
                justify-content: center;
            }
            #toc-overlay {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(0,0,0,0.5);
                z-index: 100;
                backdrop-filter: blur(2px);
            }
            #toc-overlay.show {
                display: block;
            }
        }
        </style>
    </head>
    <body>
        <header class="container-fluid">
            <hgroup>
            <nav>
                <ul>
                    <li><strong>{{ .Site.Meta.Title }}</strong></li>
                </ul>
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><button id="theme-toggle" class="outline contrast" aria-label="Toggle dark mode">🌙</button></li>
                </ul>
            </nav>
            {{- $crumbs := breadcrumbs .Page.Path }}
            {{- if gt (len $crumbs) 1 }}
            <nav aria-label="breadcrumb">
                <ul>
                    {{- range $crumbs }}
                    <li><a href="{{ .Path }}">{{ .Label }}</a></li>
                    {{- end }}
                </ul>
            </nav>
            {{- end }}
            </hgroup>
        </header>

        <main class="container-fluid">
            {{- $toc := toc .Page.TOC }}
            <div class="page-layout">
                {{- if $toc }}
                <aside id="toc-sidebar">
                    <nav>
                        <header><strong>Contents</strong></header>
                        {{ $toc }}
                    </nav>
                </aside>
                <div id="toc-overlay"></div>
                <button id="toc-toggle" class="contrast" aria-label="Toggle Table of Contents">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </button>
                {{- end }}
                
                <article class="page-content">
                    {{ .Page.Content }}
                </article>
            </div>
        </main>

        <script>
            // TOC functionality - wrapped in IIFE for encapsulation
            (function() {
                'use strict';

                // Mobile TOC Toggle
                const tocToggle = document.getElementById('toc-toggle');
                const tocSidebar = document.getElementById('toc-sidebar');
                const tocOverlay = document.getElementById('toc-overlay');

                if (tocToggle && tocSidebar) {
                    const toggleToc = () => {
                        const isShown = tocSidebar.classList.contains('show');
                        tocSidebar.classList.toggle('show', !isShown);
                        if (tocOverlay) tocOverlay.classList.toggle('show', !isShown);
                    };

                    tocToggle.addEventListener('click', toggleToc);
                    if (tocOverlay) tocOverlay.addEventListener('click', toggleToc);

                    // Close on link click (mobile only)
                    tocSidebar.addEventListener('click', (e) => {
                        if (e.target.tagName === 'A' && window.innerWidth <= 992) {
                            toggleToc();
                        }
                    });
                }

                // Scroll Highlighting with IntersectionObserver
                if (tocSidebar) {
                    const observer = new IntersectionObserver((entries) => {
                        entries.forEach(entry => {
                            if (entry.isIntersecting) {
                                const id = entry.target.getAttribute('id');
                                if (id) {
                                    tocSidebar.querySelectorAll('a').forEach(link => {
                                        const isActive = link.getAttribute('href') === '#' + id;
                                        link.classList.toggle('active', isActive);
                                        if (isActive) {
                                            link.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                                        }
                                    });
                                }
                            }
                        });
                    }, { rootMargin: '-100px 0px -66%', threshold: 0 });

                    document.querySelectorAll('article h1[id], article h2[id], article h3[id]').forEach((section) => {
                        observer.observe(section);
                    });
                }
            })();

            // Code block copy button - wrapped in IIFE for encapsulation
            (function() {
                'use strict';
                document.querySelectorAll('pre > code').forEach(function(codeBlock) {
                    var pre = codeBlock.parentNode;
                    var btn = document.createElement('button');
                    btn.className = 'copy-btn';
                    btn.textContent = 'Copy';
                    btn.setAttribute('aria-label', 'Copy code to clipboard');
                    btn.addEventListener('click', function() {
                        navigator.clipboard.writeText(codeBlock.textContent).then(function() {
                            btn.textContent = 'Copied!';
                            btn.classList.add('copied');
                            setTimeout(function() {
                                btn.textContent = 'Copy';
                                btn.classList.remove('copied');
                            }, 2000);
                        });
                    });
                    pre.appendChild(btn);
                });
            })();
        </script>

        <script>
            // Dark/Light mode toggle - wrapped in IIFE for encapsulation
            (function() {
                'use strict';
                var toggle = document.getElementById('theme-toggle');
                var html = document.documentElement;

                // Determine initial theme from localStorage
                var stored = localStorage.getItem('theme');
                if (stored) {
                    html.setAttribute('data-theme', stored);
                }

                // Update button icon based on current theme
                function updateIcon() {
                    var current = html.getAttribute('data-theme');
                    if (!current) {
                        // Auto-detect from system preference
                        current = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                    }
                    toggle.textContent = current === 'dark' ? '\u2600\uFE0F' : '\uD83C\uDF19';
                }

                updateIcon();

                if (toggle) {
                    toggle.addEventListener('click', function() {
                        var current = html.getAttribute('data-theme');
                        if (!current) {
                            current = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                        }
                        var next = current === 'dark' ? 'light' : 'dark';
                        html.setAttribute('data-theme', next);
                        localStorage.setItem('theme', next);
                        updateIcon();
                    });
                }

                // Listen for system theme changes
                window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
                    if (!localStorage.getItem('theme')) {
                        updateIcon();
                    }
                });
            })();
        </script>

        <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.js"></script>
        <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/contrib/auto-render.min.js"
            onload="renderMathInElement(document.body, {delimiters: [{left: '$$', right: '$$', display: true},{left: '$', right: '$', display: false}]});"></script>
    </body>
</html>
