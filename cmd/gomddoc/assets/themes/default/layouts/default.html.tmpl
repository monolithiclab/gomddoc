<!DOCTYPE html>
<html lang="{{ .Lang }}">
{{ template "head" . }}
<body>
  {{ template "header" . }}
  <main>
    <div class="page-layout">
      {{ template "nav" . }}
      <div class="content-area">
        {{- $crumbs := .Page.Breadcrumbs }}
        {{- if gt (len $crumbs) 1 }}
        <nav aria-label="{{ .T "aria_breadcrumb" }}" class="breadcrumb-bar">
          <ul>
            {{- range $crumbs }}
            <li><a href="{{ .Path }}">{{ .Label }}</a></li>
            {{- end }}
          </ul>
        </nav>
        {{- end }}
        <div class="content-with-toc">
          <article>
            {{ template "tag-chips" . }}
            {{ if .Feature "annotations" }}<gmd-annotations>{{ .Page.Content }}</gmd-annotations>{{ else }}{{ .Page.Content }}{{ end }}

            {{ template "see-also" . }}

            {{ template "footer" . }}
          </article>
          {{ template "toc" . }}
        </div>
      </div>
    </div>
  </main>
  {{ template "scripts" . }}
</body>
</html>
