<!DOCTYPE html>
<html lang="{{ .Lang }}"
      data-copy-label="{{ .T "copy" }}"
      data-copied-label="{{ .T "copied" }}"
      data-copy-aria="{{ .T "aria_copy_code" }}"
      data-search-placeholder="{{ .T "search_placeholder" }}"
      data-search-no-results="{{ .T "search_no_results" }}"
      data-search-navigate="{{ .T "search_navigate" }}"
      data-search-open="{{ .T "search_open" }}"
      data-search-close="{{ .T "search_close" }}"
      data-search-aria="{{ .T "aria_search" }}">
{{ template "head" . }}
<body>
  {{ template "header" . }}
  <main>
    <div class="page-layout">
      {{ template "nav" . }}
      <div class="content-area">
        {{- $crumbs := breadcrumbs .Page.Path }}
        {{- if gt (len $crumbs) 1 }}
        <nav aria-label="{{ .T "aria_breadcrumb" }}" class="breadcrumb-bar">
          <ul>
            {{- range $crumbs }}
            <li><a href="{{ .Path }}">{{ .Label }}</a></li>
            {{- end }}
          </ul>
        </nav>
        {{- end }}
        <div class="content-with-toc">
          <article>
            {{ template "tag-chips" . }}
            {{ .Page.Content }}

            {{ template "see-also" . }}

            {{ template "footer" . }}
          </article>
          {{ template "toc" . }}
        </div>
      </div>
    </div>
  </main>
  {{ template "scripts" . }}
</body>
</html>
