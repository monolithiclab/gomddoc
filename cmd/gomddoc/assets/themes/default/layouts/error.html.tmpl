<!DOCTYPE html>
<html lang="{{ .Lang }}"
      data-copy-label="{{ .T "copy" }}"
      data-copied-label="{{ .T "copied" }}"
      data-copy-aria="{{ .T "aria_copy_code" }}">
{{ template "head" . }}
<body>
  {{ template "header" . }}
  <main>
    <div class="page-layout">
      <div class="content-area">
        <article class="error-page">
          <h1>{{ .Page.Meta.error_code }} {{ .Page.Meta.error_title }}</h1>
          <p>{{ .Page.Meta.error_message }}</p>
          <p><a href="/">{{ .T "go_to_homepage" }}</a></p>
        </article>
      </div>
    </div>
  </main>
  {{ template "scripts" . }}
</body>
</html>
