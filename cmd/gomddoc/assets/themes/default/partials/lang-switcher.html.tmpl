{{ define "lang-switcher" }}
{{- $langs := .Languages }}
{{- if gt (len $langs) 1 }}
      <div class="lang-switcher">
        {{- $path := .Page.Path }}
        {{- range $langs }}
        {{- if .Active }}
        <span class="lang-current">{{ .Name }}</span>
        {{- else }}
        <a href="/{{ .Code }}{{ $path }}">{{ .Name }}</a>
        {{- end }}
        {{- end }}
      </div>
{{- end }}
{{- end }}
