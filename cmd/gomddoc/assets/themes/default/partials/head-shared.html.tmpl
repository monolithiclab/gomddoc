{{- /*
    Shared head meta tags: canonical URL, prev/next, OpenGraph, Twitter Card,
    viewport, color-scheme, and description. Used by all themes to avoid
    duplicating the same ~20-line block in every head.html.tmpl.

    Themes call {{ template "head-meta" . }} after <meta charset> and <title>.
*/ -}}

{{ define "head-meta" }}
        {{ $url := canonicalURL .Page.Path }}{{ if $url }}
        <link rel="canonical" href="{{ $url }}">{{ end }}
        {{ $feedURL := canonicalURL "/feed.xml" }}{{ if $feedURL }}
        <link rel="alternate" type="application/atom+xml" title="{{ .Site.Meta.Title }}" href="{{ $feedURL }}">{{ end }}
        {{ if .Page.PrevPage }}{{ $prevURL := canonicalURL .Page.PrevPage.Path }}{{ if $prevURL }}
        <link rel="prev" href="{{ $prevURL }}">{{ end }}{{ end }}
        {{ if .Page.NextPage }}{{ $nextURL := canonicalURL .Page.NextPage.Path }}{{ if $nextURL }}
        <link rel="next" href="{{ $nextURL }}">{{ end }}{{ end }}
        {{ if $url }}<meta property="og:url" content="{{ $url }}">{{ end }}
        {{ if .Page.Meta.og_type }}<meta property="og:type" content="{{ .Page.Meta.og_type }}">{{ else }}<meta property="og:type" content="article">{{ end }}
        <meta property="og:site_name" content="{{ .Site.Meta.Title }}">
        {{ if .Page.Meta.title }}<meta property="og:title" content="{{ .Page.Meta.title }}">{{ end }}
        {{ if .Page.Meta.description }}<meta property="og:description" content="{{ .Page.Meta.description }}">
        {{ else if .Site.Meta.Description }}<meta property="og:description" content="{{ .Site.Meta.Description }}">{{ end }}
        <meta name="twitter:card" content="summary">
        {{ if .Page.Meta.title }}<meta name="twitter:title" content="{{ .Page.Meta.title }}">{{ end }}
        {{ if .Page.Meta.description }}<meta name="twitter:description" content="{{ .Page.Meta.description }}">
        {{ else if .Site.Meta.Description }}<meta name="twitter:description" content="{{ .Site.Meta.Description }}">{{ end }}
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="{{ .Site.Meta.Description }}">
{{- end }}

{{ define "head-katex" }}
        {{- if .Feature "katex" }}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css" />
        {{- end }}
{{- end }}

{{ define "scripts-shared" }}
        {{- if .Feature "toc" }}
        <script>{{ inlineJSAsset "toc-highlight.mjs" }}</script>
        {{- end }}
        {{- if .Feature "code_copy" }}
        <script>{{ inlineJSAsset "code-copy.mjs" }}</script>
        {{- end }}
        {{- if .Feature "katex" }}
        <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.js"></script>
        <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/contrib/auto-render.min.js"></script>
        <script>document.addEventListener("DOMContentLoaded",function(){renderMathInElement(document.body,{delimiters:[{left:"$$",right:"$$",display:true},{left:"$",right:"$",display:false}]})});</script>
        {{- end }}
        {{- if .Feature "color_chips" }}
        <script type="module">{{ inlineJSAsset "color-chip.mjs" }}</script>
        {{- end }}
        {{- if .Feature "search" }}
        <script type="module">{{ inlineJSAsset "search.mjs" }}</script>
        {{- end }}
{{- end }}
